# Example nginx server block for nitpitch.app.
#
# Start HTTP-only (port 80) so certbot can complete the ACME challenge; then run
#   sudo certbot --nginx -d nitpitch.app -d www.nitpitch.app
# and certbot ADDS the `listen 443 ssl` block + the HTTP->HTTPS redirect for you.
# Do NOT hand-write the 443 block.
#
# BOTH names, every time. `www` has a DNS record pointing at this box, so a
# cert covering only the apex still leaves nginx answering for www — and the
# TLS handshake fails before nginx can respond at all. Chrome shows a full
# security interstitial; Safari may hide it behind a cached redirect, so
# spot-checking in one browser can miss it entirely. Verify with:
#   openssl s_client -connect www.nitpitch.app:443 -servername www.nitpitch.app \
#     </dev/null | openssl x509 -noout -ext subjectAltName
#
# If certbot fails with "Invalid response … 404" for www, the ACME challenge
# isn't reachable on that name: Let's Encrypt fetches
# http://www.nitpitch.app/.well-known/acme-challenge/<token> over plain HTTP,
# and anything that redirects or 404s that path blocks issuance. Both names
# must be served from the same block (as below) or the challenge path
# explicitly excepted before any redirect.
#
# `root` points at the web root ITSELF — deploy.sh builds straight into it
# (--cleanDestinationDir), there is no `public/` subdir. Keep this in step with
# WEBROOT in deploy.sh (default /var/www/nitpitch.app).

server {
    listen 80;
    listen [::]:80;
    server_name nitpitch.app www.nitpitch.app;

    root /var/www/nitpitch.app;
    index index.html;

    # Hugo builds 404.html at the web root.
    error_page 404 /404.html;

    # Apple App Site Association: no extension, served as JSON, NO redirect.
    # Exact-match so it wins over the dotfile deny and the try_files catch-all.
    # The app has no Universal Links today — this is here so that adding them
    # later is dropping a file into .well-known, not editing the server block.
    location = /.well-known/apple-app-site-association {
        default_type application/json;
    }

    # Hugo emits clean directory URLs (/support/ -> /support/index.html).
    location / {
        try_files $uri $uri/ =404;
    }

    # Fingerprinted CSS: filename changes on content change, so cache hard.
    location /css/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Don't serve dotfiles — except the .well-known dir (matched exactly above).
    location ~ /\.(?!well-known) {
        deny all;
    }
}
